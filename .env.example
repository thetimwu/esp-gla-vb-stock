# Copy to .env locally and replace every placeholder. Never commit real values.
# URL-encode the MongoDB username/password if they contain URI-reserved characters.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=3000
MONGO_INITDB_ROOT_USERNAME=replace-with-a-local-root-username
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-unique-local-root-password
MONGO_APP_USERNAME=replace-with-a-local-application-username
MONGO_APP_PASSWORD=replace-with-a-unique-local-application-password
MONGO_DATABASE=gate_inventory
MONGODB_URI=mongodb://replace-with-a-local-application-username:replace-with-a-unique-local-application-password@mongodb:27017/gate_inventory?authSource=gate_inventory&replicaSet=rs0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET=replace-with-at-least-32-random-characters
HTTPS_ENABLED=false
