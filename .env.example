# Copy to .env locally and replace every placeholder. Never commit real values.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gate_inventory
# Application role (least-privilege; used by the backend)
DB_USER=gate_inventory_app
DB_PASSWORD=replace-with-a-unique-local-database-password
# Bootstrap database administrator (used only by the PostgreSQL image)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-a-unique-random-session-secret-at-least-32-characters
TRUST_PROXY_HOPS=0
